# ==============================================================================
# Voyager AI — Exemplo de variáveis de ambiente
# ------------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores reais.
#   PowerShell:  Copy-Item .env.example .env
#
# ATENÇÃO: `.env` está no .gitignore e NUNCA deve ser versionado.
# Em produção, use o Env Group do Render (não arquivos .env).
# Referência das decisões: PRD.md §2 (D2, D10, D11, D12)
# ==============================================================================


# ------------------------------------------------------------------------------
# LLM — Gateway primário: OpenCode Go (PRD D2)
# ------------------------------------------------------------------------------
# Assinatura OpenCode Go (~US$ 60/mês de uso incluído). Obtenha a chave em:
#   https://opencode.ai/ -> OpenCode Zen -> assinar Go -> copiar API key
# Endpoint OpenAI-compatible, usado via litellm.
OPENCODE_API_KEY=sua_chave_opencode_go_aqui
OPENCODE_API_BASE=https://opencode.ai/zen/go/v1

# Modelos por tier (ver PRD §2.2). Apenas modelos servidos em /chat/completions.
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_FAST_TOOLS=kimi-k2.7-code

# Teto de requests da aplicação no Go, para preservar a cota de uso pessoal
# de coding (PRD §12 / Q2). Ao exceder, faz failover para o OpenRouter.
LLM_GO_MAX_REQUESTS_PER_DAY=200


# ------------------------------------------------------------------------------
# LLM — Fallback universal + tier `pro`: OpenRouter (PRD D2)
# ------------------------------------------------------------------------------
# Obtenha em: https://openrouter.ai/keys
# Com >= US$ 10 em créditos, os modelos `:free` liberam 1.000 req/dia.
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Tier `pro` (output final do roteiro) e cadeia de fallback.
LLM_MODEL_PRO=openrouter/google/gemini-3.5-flash
LLM_FALLBACK_FAST=openrouter/google/gemini-3.5-flash
# Fallback de tools precisa suportar function calling (validar com scripts/check_env.py)
LLM_FALLBACK_TOOLS=openrouter/nvidia/nemotron-3-super-120b-a12b:free


# ------------------------------------------------------------------------------
# Busca web para os agentes — Tavily (PRD D11)
# ------------------------------------------------------------------------------
# Obtenha em: https://app.tavily.com/  (1.000 créditos/mês renováveis)
# Substitui o Serper: retorna conteúdo já extraído e otimizado para LLM.
TAVILY_API_KEY=sua_chave_tavily_aqui


# ------------------------------------------------------------------------------
# Geocoding — Geoapify (PRD D10)
# ------------------------------------------------------------------------------
# Obtenha em: https://myprojects.geoapify.com/  (3.000 req/dia, sem cartão)
# Substitui o Nominatim público (que proíbe uso produtivo e limita 1 req/s).
GEOAPIFY_API_KEY=sua_chave_geoapify_aqui


# ------------------------------------------------------------------------------
# Observabilidade de LLM — Langfuse Cloud (PRD D12)
# ------------------------------------------------------------------------------
# Obtenha em: https://cloud.langfuse.com/ -> Project Settings -> API Keys
# Free tier Hobby: 50k observações/mês. Habilita o FinOps de custo real (S4).
LANGFUSE_PUBLIC_KEY=pk-lf-sua_chave_publica_aqui
LANGFUSE_SECRET_KEY=sk-lf-sua_chave_secreta_aqui
# Região: https://cloud.langfuse.com (EU) ou https://us.cloud.langfuse.com (US)
# ATENÇÃO: use o host da região onde o projeto foi criado, senão a API retorna 401.
LANGFUSE_HOST=https://cloud.langfuse.com


# ------------------------------------------------------------------------------
# Telemetria de infraestrutura — OpenTelemetry (traces OTLP)
# ------------------------------------------------------------------------------
# Complementa o Langfuse: HTTP, banco, Redis e jobs do worker (o Langfuse cobre
# apenas as chamadas de LLM). Vazio = telemetria desligada (sem overhead).
# Backends com free tier: Grafana Cloud, Honeycomb, New Relic (GitHub Student).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Autenticação do backend, no formato padrão OTel: chave=valor,chave2=valor2
# Ex.: Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=voyager-api


# ------------------------------------------------------------------------------
# Infraestrutura
# ------------------------------------------------------------------------------
# Redis — cache de roteiros, cache de geocoding/busca, fila e rate limiting.
# Local (docker-compose): redis://localhost:6379/0
# Se vazio, o cache é desativado automaticamente (degradação graciosa).
REDIS_URL=
CACHE_TTL_SECONDS=86400

# PostgreSQL — persistência de execuções e roteiros (Fase 1 / ADR-0008).
# Local (docker compose): postgresql+asyncpg://voyager:voyager@localhost:5432/voyager
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Fila de jobs (ADR-0014) — usa o mesmo Redis
QUEUE_NAME=voyager
JOB_TIMEOUT_SECONDS=600
WORKER_CONCURRENCY=2


# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------
# Ambiente: local | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# Rate limiting da demo pública sem autenticação (PRD FR-09).
RATE_LIMIT_EXECUTIONS_PER_HOUR=5

# Origens permitidas no CORS, separadas por vírgula.
# Vazio = apenas localhost (dev). Nunca use `*`.
CORS_ALLOWED_ORIGINS=
